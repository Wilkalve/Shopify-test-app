{% assign shop_domain = shop.myshopify_domain %}
{% assign encoded_host = shop_domain | append: '/admin' | base64_encode %}

<iframe
  src="https://shopify-test-app-production.up.railway.app/storefront?shop={{ shop_domain }}&host={{ encoded_host }}"
  width="100%"
  height="300"
  style="border: none; border-radius: 10px; background: #f9f9f9;"
></iframe>
