<div id="model-upload-wrapper" style="margin-top: 20px;">
  <form
    method="POST"
    action="https://your-remix-app-url.com/api/upload-proxy"
    enctype="multipart/form-data"
    style="display: flex; flex-direction: column;"
  >
    <label
      for="file"
      style="color: {{ section.settings.label_color }}; font-weight: bold;"
    >
      {{ section.settings.model_label }}
    </label>

    <input
      type="file"
      name="file"
      id="file"
      required
      style="margin-top: 8px; padding: 10px; border: 1px solid #ccc; border-radius: 4px;"
    />

    <button
      type="submit"
      style="margin-top: 12px; padding: 10px 16px; background-color: #5c6ac4; color: white; border: none; border-radius: 4px;"
    >
      Upload
    </button>
  </form>

  {% if section.settings.show_preview %}
    <div id="upload-preview" style="margin-top: 16px;">
      <p>File preview will appear here.</p>
    </div>
  {% endif %}
</div>
